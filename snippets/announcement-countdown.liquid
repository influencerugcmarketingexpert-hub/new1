<span class="sab-countdown" data-countdown-end="{{ end_date }}">
  <span class="sab-countdown__days"><span class="sab-countdown__value">--</span><span class="sab-countdown__label">{{ 'sections.premium_announcement.days' | t }}</span></span>
  <span class="sab-countdown__hours"><span class="sab-countdown__value">--</span><span class="sab-countdown__label">{{ 'sections.premium_announcement.hours' | t }}</span></span>
  <span class="sab-countdown__minutes"><span class="sab-countdown__value">--</span><span class="sab-countdown__label">{{ 'sections.premium_announcement.minutes' | t }}</span></span>
  <span class="sab-countdown__seconds"><span class="sab-countdown__value">--</span><span class="sab-countdown__label">{{ 'sections.premium_announcement.seconds' | t }}</span></span>
</span>
