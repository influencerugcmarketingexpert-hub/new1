  <style>
    #sab-{{ section.id }} {
      --sab-bg: {{ section.settings.sab_bg_color }};
      --sab-text: {{ section.settings.sab_text_color }};
      --sab-arrow: {{ section.settings.sab_arrow_color }};
      --sab-height: {{ section.settings.sab_bar_height }}px;
      --sab-font-size: {{ section.settings.sab_font_size }}px;
      --sab-letter-spacing: {{ section.settings.sab_letter_spacing | divided_by: 100.0 }}em;
      --sab-font-weight: {{ section.settings.sab_font_weight }};
      --sab-text-transform: {{ section.settings.sab_text_transform }};
      --sab-marquee-speed: {{ section.settings.sab_marquee_speed }}s;
    }

    #sab-{{ section.id }}.sab-wrapper {
      {%- if section.settings.sab_enable_gradient -%}
        background: linear-gradient({{ section.settings.sab_gradient_direction }}, var(--sab-bg), {{ section.settings.sab_gradient_color_2 }});
      {%- else -%}
        background-color: var(--sab-bg);
      {%- endif -%}
      color: var(--sab-text);
      width: 100%;
      overflow: hidden;
      position: relative;
      font-family: inherit;
      z-index: 10;
    }

    #sab-{{ section.id }} .sab-countdown {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4px 10px 0;
      font-size: calc(var(--sab-font-size) - 1px);
      font-weight: 600;
      letter-spacing: 0.05em;
    }

    #sab-{{ section.id }} .sab-inner {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: var(--sab-height);
      padding: 0 40px;
      position: relative;
    }

    #sab-{{ section.id }} .sab-content {
      overflow: hidden;
      height: var(--sab-height);
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Slider mode */
    #sab-{{ section.id }} .sab-slider {
      transition: transform 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
      will-change: transform;
    }

    #sab-{{ section.id }} .sab-slide {
      display: flex;
      align-items: center;
      justify-content: center;
      height: var(--sab-height);
      text-align: center;
      gap: 6px;
    }

    /* Fade mode */
    #sab-{{ section.id }} .sab-fade {
      display: grid;
      width: 100%;
      height: var(--sab-height);
    }

    #sab-{{ section.id }} .sab-fade__slide {
      grid-area: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
      height: var(--sab-height);
      text-align: center;
      gap: 6px;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.5s cubic-bezier(0.25, 0.1, 0.25, 1), visibility 0.5s;
    }

    #sab-{{ section.id }} .sab-fade__slide--active {
      opacity: 1;
      visibility: visible;
    }

    /* Marquee mode */
    #sab-{{ section.id }} .sab-marquee {
      display: flex;
      width: 100%;
      overflow: hidden;
    }

    #sab-{{ section.id }} .sab-marquee__track {
      display: flex;
      align-items: center;
      gap: 40px;
      white-space: nowrap;
      min-width: max-content;
      padding: 0 20px;
      animation: sab-marquee-{{ section.id }} var(--sab-marquee-speed) linear infinite;
    }

    #sab-{{ section.id }} .sab-marquee__item {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }

    @keyframes sab-marquee-{{ section.id }} {
      0% {
        transform: translate3d(0, 0, 0);
      }
      100% {
        transform: translate3d(-100%, 0, 0);
      }
    }

    /* Shared text styles */
    #sab-{{ section.id }} .sab-text,
    #sab-{{ section.id }} .sab-link {
      font-size: var(--sab-font-size);
      font-weight: var(--sab-font-weight);
      text-transform: var(--sab-text-transform);
      letter-spacing: var(--sab-letter-spacing);
      color: var(--sab-text);
      text-decoration: none;
      line-height: 1.4;
      padding: 4px 10px;
    }

    #sab-{{ section.id }} .sab-link:hover {
      text-decoration: underline;
    }

    #sab-{{ section.id }} .sab-icon {
      flex-shrink: 0;
      color: var(--sab-text);
    }

    /* Arrows */
    #sab-{{ section.id }} .sab-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: var(--sab-arrow);
      cursor: pointer;
      padding: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2;
      opacity: 0.8;
      transition: opacity 0.2s ease;
    }

    #sab-{{ section.id }} .sab-arrow:hover {
      opacity: 1;
    }

    #sab-{{ section.id }} .sab-arrow--prev {
      left: 12px;
    }

    #sab-{{ section.id }} .sab-arrow--next {
      right: 12px;
    }

    /* Close button */
    #sab-{{ section.id }} .sab-close {
      position: absolute;
      top: 50%;
      right: 12px;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: var(--sab-arrow);
      cursor: pointer;
      padding: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2;
      opacity: 0.8;
      transition: opacity 0.2s ease;
    }

    #sab-{{ section.id }} .sab-close:hover {
      opacity: 1;
    }

    /* Dots */
    #sab-{{ section.id }} .sab-dots {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding-bottom: 6px;
    }

    #sab-{{ section.id }} .sab-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background-color: var(--sab-text);
      opacity: 0.35;
      border: none;
      padding: 0;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    #sab-{{ section.id }} .sab-dot--active {
      opacity: 1;
    }

    /* Hidden state */
    #sab-{{ section.id }}.sab-hidden {
      display: none;
    }

    /* Mobile hide */
    {%- if section.settings.sab_hide_on_mobile -%}
      @media screen and (max-width: 749px) {
        #sab-{{ section.id }}.sab-wrapper {
          display: none;
        }
      }
    {%- endif -%}

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
      #sab-{{ section.id }} .sab-slider {
        transition: none;
      }
      #sab-{{ section.id }} .sab-fade__slide {
        transition: none;
      }
      #sab-{{ section.id }} .sab-marquee__track {
        animation: none;
      }
    }
  </style>

  <script>
    (function() {
      var sectionId = '{{ section.id }}';
      var container = document.getElementById('sab-' + sectionId);
      if (!container) return;

      var displayMode = container.getAttribute('data-display-mode');
      var dismissedKey = container.getAttribute('data-dismissed-key');
      var autoRotate = container.getAttribute('data-auto-rotate') === 'true';
      var rotateSpeed = parseInt(container.getAttribute('data-rotate-speed'), 10) * 1000;
      var countdownEnable = container.getAttribute('data-countdown-enable') === 'true';
      var countdownEnd = container.getAttribute('data-countdown-end');
      var countdownExpiredMsg = container.getAttribute('data-countdown-expired-msg');

      // Session dismiss check
      if (sessionStorage.getItem(dismissedKey) === '1') {
        container.classList.add('sab-hidden');
        return;
      }

      var currentIndex = 0;
      var timer = null;
      var countdownInterval = null;

      // Get slides based on mode
      var slides, totalSlides, slider, fadeContainer;
      if (displayMode === 'slider') {
        slider = container.querySelector('[data-slider-container]');
        slides = container.querySelectorAll('.sab-slide');
        totalSlides = slides.length;
      } else if (displayMode === 'fade') {
        fadeContainer = container.querySelector('[data-fade-container]');
        slides = container.querySelectorAll('.sab-fade__slide');
        totalSlides = slides.length;
      } else {
        totalSlides = 0;
      }

      var dots = container.querySelectorAll('.sab-dot');
      var prevBtn = container.querySelector('.sab-arrow--prev');
      var nextBtn = container.querySelector('.sab-arrow--next');
      var closeBtn = container.querySelector('.sab-close');

      var barHeight = container.querySelector('.sab-content') ? container.querySelector('.sab-content').offsetHeight : 44;

      function goTo(index) {
        if (totalSlides <= 0) return;
        if (index < 0) index = totalSlides - 1;
        if (index >= totalSlides) index = 0;
        currentIndex = index;

        if (displayMode === 'slider' && slider) {
          slider.style.transform = 'translateY(-' + (currentIndex * barHeight) + 'px)';
        } else if (displayMode === 'fade' && slides) {
          for (var i = 0; i < slides.length; i++) {
            slides[i].classList.remove('sab-fade__slide--active');
          }
          slides[currentIndex].classList.add('sab-fade__slide--active');
        }
        updateDots();
      }

      function updateDots() {
        if (dots.length === 0) return;
        for (var i = 0; i < dots.length; i++) {
          dots[i].classList.remove('sab-dot--active');
        }
        if (dots[currentIndex]) {
          dots[currentIndex].classList.add('sab-dot--active');
        }
      }

      function startTimer() {
        if (!autoRotate || totalSlides <= 1 || displayMode === 'marquee') return;
        stopTimer();
        timer = setInterval(function() {
          goTo(currentIndex + 1);
        }, rotateSpeed);
      }

      function stopTimer() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      function resetTimer() {
        stopTimer();
        startTimer();
      }

      function recalcHeight() {
        barHeight = container.querySelector('.sab-content') ? container.querySelector('.sab-content').offsetHeight : 44;
        if (displayMode === 'slider' && slider) {
          slider.style.transform = 'translateY(-' + (currentIndex * barHeight) + 'px)';
        }
      }

      // Navigation arrows
      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          goTo(currentIndex - 1);
          resetTimer();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          goTo(currentIndex + 1);
          resetTimer();
        });
      }

      // Dot navigation
      for (var i = 0; i < dots.length; i++) {
        dots[i].addEventListener('click', (function(idx) {
          return function() {
            goTo(idx);
            resetTimer();
          };
        })(i));
      }

      // Close button
      if (closeBtn) {
        closeBtn.addEventListener('click', function() {
          container.classList.add('sab-hidden');
          sessionStorage.setItem(dismissedKey, '1');
          stopTimer();
          if (countdownInterval) clearInterval(countdownInterval);
        });
      }

      // Pause on hover
      container.addEventListener('mouseenter', function() {
        stopTimer();
      });

      container.addEventListener('mouseleave', function() {
        startTimer();
      });

      // Keyboard navigation
      container.addEventListener('keydown', function(e) {
        if (displayMode === 'marquee') return;
        if (e.key === 'ArrowLeft') {
          goTo(currentIndex - 1);
          resetTimer();
        } else if (e.key === 'ArrowRight') {
          goTo(currentIndex + 1);
          resetTimer();
        }
      });

      // Window resize
      window.addEventListener('resize', function() {
        recalcHeight();
      });

      // Countdown timer
      if (countdownEnable && countdownEnd) {
        var timerEl = container.querySelector('[data-countdown-timer]');
        if (timerEl) {
          function parseEndDate(dateStr) {
            if (!dateStr) return null;
            var parts = dateStr.trim().split(' ');
            var dateParts = parts[0].split('-');
            var year = parseInt(dateParts[0], 10);
            var month = parseInt(dateParts[1], 10) - 1;
            var day = parseInt(dateParts[2], 10);
            var hours = 0, minutes = 0;
            if (parts.length > 1) {
              var timeParts = parts[1].split(':');
              hours = parseInt(timeParts[0], 10) || 0;
              minutes = parseInt(timeParts[1], 10) || 0;
            }
            return new Date(year, month, day, hours, minutes, 0);
          }

          function updateCountdown() {
            var endDate = parseEndDate(countdownEnd);
            if (!endDate) return;
            var now = new Date();
            var diff = endDate - now;

            if (diff <= 0) {
              timerEl.textContent = countdownExpiredMsg || 'Offer has expired';
              if (countdownInterval) clearInterval(countdownInterval);
              return;
            }

            var days = Math.floor(diff / 86400000);
            var hrs = Math.floor((diff % 86400000) / 3600000);
            var mins = Math.floor((diff % 3600000) / 60000);
            var secs = Math.floor((diff % 60000) / 1000);

            var pad = function(n) { return n < 10 ? '0' + n : n; };
            timerEl.textContent = pad(days) + ':' + pad(hrs) + ':' + pad(mins) + ':' + pad(secs);
          }

          updateCountdown();
          countdownInterval = setInterval(updateCountdown, 1000);
        }
      }

      // Start auto-rotation
      startTimer();

      // Shopify Theme Editor events
      if (Shopify && Shopify.designMode) {
        document.addEventListener('shopify:section:load', function(event) {
          if (event.detail.sectionId === sectionId) {
            recalcHeight();
            startTimer();
          }
        });

        document.addEventListener('shopify:block:select', function(event) {
          if (event.detail.sectionId === sectionId) {
            stopTimer();
            var blockEl = event.target.closest('[data-slide-index]');
            if (blockEl) {
              var idx = parseInt(blockEl.getAttribute('data-slide-index'), 10);
              goTo(idx);
            }
          }
        });

        document.addEventListener('shopify:block:deselect', function(event) {
          if (event.detail.sectionId === sectionId) {
            startTimer();
          }
        });
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Premium Announcement Bar",
