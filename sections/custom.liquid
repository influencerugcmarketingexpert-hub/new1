                    {%- when 'tag' -%}
                      <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 1h5l7 7-5 5-7-7V1z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><circle cx="4" cy="4" r="1" fill="currentColor"/></svg>
                    {%- when 'star' -%}
                      <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1l1.8 3.6L13 5.2l-3 2.9.7 4.1L7 10.4l-3.7 1.8.7-4.1-3-2.9 4.2-.6L7 1z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
                    {%- when 'heart' -%}
                      <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 12S1 8.5 1 5a3 3 0 015.5-1.7h1A3 3 0 0113 5c0 3.5-6 7-6 7z" stroke="currentColor" stroke-width="1.2"/></svg>
                    {%- when 'gift' -%}
                      <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="1" y="5" width="12" height="3" rx="0.5" stroke="currentColor" stroke-width="1.2"/><rect x="2" y="8" width="10" height="5" rx="0.5" stroke="currentColor" stroke-width="1.2"/><path d="M7 5v8M4 5c0-2 1.5-3 3-3s3 1 3 3" stroke="currentColor" stroke-width="1.2"/></svg>
                    {%- when 'clock' -%}
                      <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.2"/><path d="M7 3v4l2.5 2.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                    {%- when 'sparkles' -%}
                      <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1v2M7 11v2M1 7h2M11 7h2M3 3l1.5 1.5M9.5 9.5L11 11M11 3l-1.5 1.5M4.5 9.5L3 11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                    {%- when 'megaphone' -%}
                      <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M12 2v10L5 9V5l7-3z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M5 5H3a1 1 0 00-1 1v2a1 1 0 001 1h2M5 9l1 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- when 'fire' -%}
                      <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1C5 4 3 5.5 3 8.5a4 4 0 008 0C11 5.5 9 4 7 1z" stroke="currentColor" stroke-width="1.2"/><path d="M7 7c-1 1.5-1.5 2-1.5 3.2a1.5 1.5 0 003 0C8.5 9 8 8.5 7 7z" stroke="currentColor" stroke-width="1.2"/></svg>
                  {%- endcase -%}
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" class="sab-link" tabindex="-1">{{ block.settings.text }}</a>
                  {%- else -%}
                    <span class="sab-text">{{ block.settings.text }}</span>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- elsif display_mode == 'fade' -%}
          <div class="sab-fade" data-fade-container>
            {%- for block in section.blocks -%}
              <div class="sab-fade__slide{% if forloop.first %} sab-fade__slide--active{% endif %}" {{ block.shopify_attributes }} data-slide-index="{{ forloop.index0 }}">
                {%- case block.settings.icon -%}
                  {%- when 'truck' -%}
                    <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 2h8v7H1z" stroke="currentColor" stroke-width="1.2"/><path d="M9 5h2.5L13 7.5V9h-4V5z" stroke="currentColor" stroke-width="1.2"/><circle cx="3.5" cy="10.5" r="1.5" stroke="currentColor" stroke-width="1.2"/><circle cx="10.5" cy="10.5" r="1.5" stroke="currentColor" stroke-width="1.2"/></svg>
                  {%- when 'tag' -%}
                    <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 1h5l7 7-5 5-7-7V1z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><circle cx="4" cy="4" r="1" fill="currentColor"/></svg>
                  {%- when 'star' -%}
                    <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1l1.8 3.6L13 5.2l-3 2.9.7 4.1L7 10.4l-3.7 1.8.7-4.1-3-2.9 4.2-.6L7 1z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
                  {%- when 'heart' -%}
                    <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 12S1 8.5 1 5a3 3 0 015.5-1.7h1A3 3 0 0113 5c0 3.5-6 7-6 7z" stroke="currentColor" stroke-width="1.2"/></svg>
                  {%- when 'gift' -%}
                    <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="1" y="5" width="12" height="3" rx="0.5" stroke="currentColor" stroke-width="1.2"/><rect x="2" y="8" width="10" height="5" rx="0.5" stroke="currentColor" stroke-width="1.2"/><path d="M7 5v8M4 5c0-2 1.5-3 3-3s3 1 3 3" stroke="currentColor" stroke-width="1.2"/></svg>
                  {%- when 'clock' -%}
                    <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.2"/><path d="M7 3v4l2.5 2.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                  {%- when 'sparkles' -%}
                    <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1v2M7 11v2M1 7h2M11 7h2M3 3l1.5 1.5M9.5 9.5L11 11M11 3l-1.5 1.5M4.5 9.5L3 11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                  {%- when 'megaphone' -%}
                    <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M12 2v10L5 9V5l7-3z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M5 5H3a1 1 0 00-1 1v2a1 1 0 001 1h2M5 9l1 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- when 'fire' -%}
                    <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1C5 4 3 5.5 3 8.5a4 4 0 008 0C11 5.5 9 4 7 1z" stroke="currentColor" stroke-width="1.2"/><path d="M7 7c-1 1.5-1.5 2-1.5 3.2a1.5 1.5 0 003 0C8.5 9 8 8.5 7 7z" stroke="currentColor" stroke-width="1.2"/></svg>
                {%- endcase -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="sab-link">{{ block.settings.text }}</a>
                {%- else -%}
                  <span class="sab-text">{{ block.settings.text }}</span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="sab-slider" data-slider-container>
            {%- for block in section.blocks -%}
              <div class="sab-slide" {{ block.shopify_attributes }} data-slide-index="{{ forloop.index0 }}">
                {%- case block.settings.icon -%}
                  {%- when 'truck' -%}
                    <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 2h8v7H1z" stroke="currentColor" stroke-width="1.2"/><path d="M9 5h2.5L13 7.5V9h-4V5z" stroke="currentColor" stroke-width="1.2"/><circle cx="3.5" cy="10.5" r="1.5" stroke="currentColor" stroke-width="1.2"/><circle cx="10.5" cy="10.5" r="1.5" stroke="currentColor" stroke-width="1.2"/></svg>
                  {%- when 'tag' -%}
                    <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 1h5l7 7-5 5-7-7V1z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><circle cx="4" cy="4" r="1" fill="currentColor"/></svg>
                  {%- when 'star' -%}
                    <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1l1.8 3.6L13 5.2l-3 2.9.7 4.1L7 10.4l-3.7 1.8.7-4.1-3-2.9 4.2-.6L7 1z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
                  {%- when 'heart' -%}
                    <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 12S1 8.5 1 5a3 3 0 015.5-1.7h1A3 3 0 0113 5c0 3.5-6 7-6 7z" stroke="currentColor" stroke-width="1.2"/></svg>
                  {%- when 'gift' -%}
                    <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="1" y="5" width="12" height="3" rx="0.5" stroke="currentColor" stroke-width="1.2"/><rect x="2" y="8" width="10" height="5" rx="0.5" stroke="currentColor" stroke-width="1.2"/><path d="M7 5v8M4 5c0-2 1.5-3 3-3s3 1 3 3" stroke="currentColor" stroke-width="1.2"/></svg>
                  {%- when 'clock' -%}
                    <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.2"/><path d="M7 3v4l2.5 2.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                  {%- when 'sparkles' -%}
                    <svg class="sab-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1v2M7 11v2M1 7h2M11 7h2M3 3l1.5 1.5M9.5 9.5L11 11M11 3l-1.5 1.5M4.5 9.5L3 11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
